/*
------------------------------------------------------------------------
Security Testing Script
------------------------------------------------------------------------
Purpose:
- Tests Row-Level Security (RLS) policies on core tables
- Tests security views for each role (Client/Consultant/Manager/Executive)
- Verifies users can only access their authorized data

Usage:
- Run entire script as admin/dbo
- Reverts back to admin after each test

Expected Results:
- Clients see only their own data (filtered by client_id)
- Consultants see only their own assignments (filtered by consultant_id)
- Managers see all data
- Executives see all data

*/

-- Test as CLI-5001 (Client)
EXECUTE AS USER = 'CLI-5001';
SELECT USER_NAME() AS logged_in_user;
SELECT * FROM security.vw_client_portal;
SELECT * FROM core.crm_clients;
SELECT * FROM core.crm_projects;
SELECT * FROM core.crm_invoices;
REVERT;

